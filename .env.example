# Copy to .env on the server. Never commit .env.
# Prefer a restricted key (rk_test_ / rk_live_) over a secret key.

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://your-public-host

# Optional. The app creates one Product per plan if these are empty.
STRIPE_PRICE_PRACTICE=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_CREDITS_50=
